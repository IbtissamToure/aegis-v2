# Copy to .env (never commit .env). All settings are optional.
# Keyed-hash secret for audit/ledger hashing. If unset, a random key is created in data/.aegis_secret (mode 600).
AEGIS_SECRET=
AEGIS_DEFAULT_POLICY=balanced
AEGIS_AUDIT_RETENTION_DAYS=30
AEGIS_SESSION_TTL_MIN=240
# Optional local model (never used for security decisions)
AEGIS_LLM_PROVIDER=none          # none | ollama | openai_compatible
AEGIS_OLLAMA_MODEL=qwen3:1.7b
AEGIS_OLLAMA_URL=http://127.0.0.1:11434
# External providers are off unless BOTH are set; only minimized text is sent.
AEGIS_ALLOW_EXTERNAL_LLM=0
AEGIS_LLM_BASE_URL=
AEGIS_LLM_MODEL=
AEGIS_LLM_API_KEY=
